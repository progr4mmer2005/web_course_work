<section class="hero">
  <h1>{{pageTitle}}</h1>
  <p>Элегантные украшения с акцентом на классические формы и премиальные материалы.</p>
  <a class="btn" href="/catalog">Перейти в каталог</a>
</section>

<section class="grid-3">
  <article class="card">
    <h3>Проверенное качество</h3>
    <p>Каждое изделие проходит контроль и сопровождается описанием характеристик.</p>
  </article>
  <article class="card">
    <h3>Персональная доставка</h3>
    <p>Выберите удобный часовой слот доставки от 09:00 до 21:00.</p>
  </article>
  <article class="card">
    <h3>Гибкие скидки</h3>
    <p>Система скидок учитывает промокоды, категории, товары и сумму заказа.</p>
  </article>
</section>

<section class="card" style="margin-top: 16px;">
  <h2>Популярные товары</h2>
  <div class="product-grid">
    {{#each popularProducts}}
      {{> product-card item=this showWishlistButton=true showWishlistRemove=false}}
    {{/each}}
  </div>
</section>

{{#if discountedProducts.length}}
  <section class="card" style="margin-top: 16px;">
    <h2>Товары со скидками</h2>
    <div class="product-grid">
      {{#each discountedProducts}}
        {{> product-card item=this showWishlistButton=true showWishlistRemove=false}}
      {{/each}}
    </div>
  </section>
{{/if}}

<section class="card" style="margin-top: 16px;">
  <h2>Последние отзывы о магазине</h2>
  {{#if recentStoreReviews.length}}
    <div class="reviews-list">
      {{#each recentStoreReviews}}
        <article class="review-item">
          <img src="{{#if avatar_path}}/uploads/{{avatar_path}}{{else}}/public/img/placeholder.svg{{/if}}" alt="{{full_name}}" class="review-author-avatar" onerror="this.onerror=null;this.src='/public/img/placeholder.svg';" />
          <div class="review-body">
            <p><strong>{{full_name}}</strong> · Оценка: {{rating}}/5</p>
            <p>{{comment_text}}</p>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p>Пока нет отзывов о магазине.</p>
  {{/if}}
</section>

<section class="card" style="margin-top: 16px;">
  <h2>Оставить отзыв о магазине</h2>
  <p class="category">Важно: оставить отзыв можно только после оформления хотя бы одного заказа.</p>
  {{#if reviewOk}}
    <p class="in-stock">Отзыв сохранен.</p>
  {{/if}}
  {{#if reviewError}}
    <p class="out-stock">Проверьте оценку и комментарий (минимум 5 символов).</p>
  {{/if}}
  {{#if storeReviewDeleted}}
    <p class="in-stock">Отзыв о магазине удален.</p>
  {{/if}}
  {{#if storeReviewDeleteError}}
    <p class="out-stock">Не удалось удалить отзыв о магазине.</p>
  {{/if}}
  {{#if isAuth}}
    {{#if userStoreReview}}
      <div class="user-review">
        <h3>Ваш отзыв о магазине</h3>
        <div class="review-item">
          <p><strong>Оценка: {{userStoreReview.rating}}/5</strong></p>
          <p>{{userStoreReview.comment_text}}</p>
        </div>
        <form class="form" method="post" action="/reviews/store">
          <label>Изменить оценку
            <select name="rating" required>
              <option value="5" {{#if (eq userStoreReview.rating 5)}}selected{{/if}}>5</option>
              <option value="4" {{#if (eq userStoreReview.rating 4)}}selected{{/if}}>4</option>
              <option value="3" {{#if (eq userStoreReview.rating 3)}}selected{{/if}}>3</option>
              <option value="2" {{#if (eq userStoreReview.rating 2)}}selected{{/if}}>2</option>
              <option value="1" {{#if (eq userStoreReview.rating 1)}}selected{{/if}}>1</option>
            </select>
          </label>
          <label>Изменить комментарий
            <input type="text" name="comment_text" required minlength="5" maxlength="500" value="{{userStoreReview.comment_text}}" />
          </label>
          <div class="review-actions">
            <button class="btn" type="submit">Обновить отзыв</button>
            <button class="btn btn-secondary" type="submit" formaction="/reviews/store/delete" formmethod="post">Удалить отзыв</button>
          </div>
        </form>
      </div>
    {{else}}
      {{#if canStoreReview}}
        <form class="form" method="post" action="/reviews/store">
          <label>Оценка
            <select name="rating" required>
              <option value="5">5</option>
              <option value="4">4</option>
              <option value="3">3</option>
              <option value="2">2</option>
              <option value="1">1</option>
            </select>
          </label>
          <label>Комментарий
            <input type="text" name="comment_text" required minlength="5" maxlength="500" />
          </label>
          <button class="btn" type="submit">Отправить отзыв</button>
        </form>
      {{else}}
        <p class="out-stock">Вы пока не можете оставить отзыв: сначала нужно оформить хотя бы один заказ.</p>
      {{/if}}
    {{/if}}
  {{else}}
    <p>Чтобы оставить отзыв, <a href="/auth/login">войдите в аккаунт</a>.</p>
  {{/if}}
</section>

